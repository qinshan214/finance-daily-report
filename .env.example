# ============================================
# 每日财经日报 - 环境变量配置模板
# 使用方法：复制此文件为 .env，然后修改对应的值
#   cp .env.example .env
# ============================================

# ============================================
# 邮箱配置（SMTP）
# ============================================
# 发件人邮箱地址
SMTP_USER=your_email@qq.com

# 邮箱授权码（不是登录密码！）
# QQ邮箱获取方式：设置 → 账户 → POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务 → 生成授权码
SMTP_PASSWORD=your_email_auth_code

# SMTP服务器地址（默认QQ邮箱）
SMTP_HOST=smtp.qq.com

# SMTP端口（默认465，SSL加密）
SMTP_PORT=465

# 收件人邮箱（可以和发件人相同）
EMAIL_TO=your_email@qq.com

# ============================================
# 飞书配置（飞书开放平台）
# ============================================
# 飞书应用 App ID
# 获取方式：https://open.feishu.cn/app → 创建企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx

# 飞书应用 App Secret
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# 脚本配置（可选）
# ============================================
# 输出目录（默认 output）
OUTPUT_DIR=output

# 日志目录（默认 logs）
LOG_DIR=logs

# 是否启用邮件推送（true/false，默认true）
ENABLE_EMAIL=true

# 是否启用飞书文档生成（true/false，默认true）
ENABLE_FEISHU=true

# 是否启用失败告警（true/false，默认true）
ENABLE_ALERT=true

# ============================================
# 模式切换配置（可选）
# ============================================
# 连续失败N次触发降级（默认2）
DEGRADE_CONSECUTIVE_FAILURES=2

# 日失败率阈值（默认0.3，即30%）
DEGRADE_DAILY_FAILURE_RATE=0.3

# 降级冷却时间（分钟，默认60）
DEGRADE_COOLDOWN_MINUTES=60

# ============================================
# 数据采集配置（可选）
# ============================================
# 新闻采集数量（默认50）
NEWS_COUNT=50

# 个股排行数量（默认10）
STOCK_RANKING_COUNT=10

# 请求超时时间（秒，默认15）
REQUEST_TIMEOUT=15

# 请求重试次数（默认2）
REQUEST_RETRIES=2
